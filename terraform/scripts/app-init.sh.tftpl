#!/bin/bash
set -euo pipefail

timedatectl set-timezone Asia/Seoul

# Swap 2GB — t2.micro(1GB RAM)에서 Spring Boot OOM 방지
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile swap swap defaults 0 0' >> /etc/fstab
fi

mkdir -p /etc/systemd/system/moa-backend.service.d

# Kafka PEM 인증서를 파일로 저장 (systemd Environment= 는 multi-line 값 불가)
%{ if kafka_ssl_truststore_cert != "" ~}
mkdir -p /opt/moa/backend/certs
cat > /opt/moa/backend/certs/kafka-ca.pem << 'KAFKA_CA_CERT_BOUNDARY'
${kafka_ssl_truststore_cert}
KAFKA_CA_CERT_BOUNDARY
chmod 600 /opt/moa/backend/certs/kafka-ca.pem
chown moa:moa /opt/moa/backend/certs/kafka-ca.pem
%{ endif ~}

%{ if kafka_ssl_keystore_cert != "" ~}
mkdir -p /opt/moa/backend/certs
cat > /opt/moa/backend/certs/kafka-service.cert << 'KAFKA_SVC_CERT_BOUNDARY'
${kafka_ssl_keystore_cert}
KAFKA_SVC_CERT_BOUNDARY
chmod 600 /opt/moa/backend/certs/kafka-service.cert
chown moa:moa /opt/moa/backend/certs/kafka-service.cert
%{ endif ~}

%{ if kafka_ssl_keystore_key != "" ~}
mkdir -p /opt/moa/backend/certs
cat > /opt/moa/backend/certs/kafka-service.key << 'KAFKA_SVC_KEY_BOUNDARY'
${kafka_ssl_keystore_key}
KAFKA_SVC_KEY_BOUNDARY
chmod 600 /opt/moa/backend/certs/kafka-service.key
chown moa:moa /opt/moa/backend/certs/kafka-service.key
%{ endif ~}

# JVM 래퍼 — PEM 인증서를 파일에서 읽어 환경변수로 주입 후 JVM 실행
cat > /opt/moa/backend/start.sh << 'START_SCRIPT_BOUNDARY'
#!/bin/bash
if [ -f /opt/moa/backend/certs/kafka-ca.pem ]; then
  export KAFKA_SSL_TRUSTSTORE_CERT="$(cat /opt/moa/backend/certs/kafka-ca.pem)"
fi
if [ -f /opt/moa/backend/certs/kafka-service.cert ]; then
  export KAFKA_SSL_KEYSTORE_CERT="$(cat /opt/moa/backend/certs/kafka-service.cert)"
fi
if [ -f /opt/moa/backend/certs/kafka-service.key ]; then
  export KAFKA_SSL_KEYSTORE_KEY="$(cat /opt/moa/backend/certs/kafka-service.key)"
fi
exec /usr/bin/java -Xms256m -Xmx256m -jar /opt/moa/backend/app.jar
START_SCRIPT_BOUNDARY
chmod +x /opt/moa/backend/start.sh
chown moa:moa /opt/moa/backend/start.sh

# 앱 환경변수는 단일 파일로 기록 (cat /etc/moa/backend/moa-backend.env 로 확인 가능)
mkdir -p /etc/moa/backend
cat > /etc/moa/backend/moa-backend.env << 'ENVFILE_EOF'
SPRING_PROFILES_ACTIVE="prod,v2"
PORT="8080"
DB_HOST="${db_host}"
SPRING_DATASOURCE_URL="jdbc:postgresql://${db_host}:${db_port}/${db_name}?sslmode=${db_sslmode}"
SPRING_DATASOURCE_USERNAME="${db_username}"
SPRING_DATASOURCE_PASSWORD="${db_password}"
REDIS_URL="rediss://default:${redis_password_urlencoded}@${redis_host}:${redis_port}"
REDIS_HOST="${redis_host}"
REDIS_PORT="${redis_port}"
REDIS_PASSWORD="${redis_password}"
KAFKA_BOOTSTRAP_SERVERS="${kafka_bootstrap_servers}"
JWT_ACCESS_SECRET="${jwt_access_secret}"
JWT_REFRESH_SECRET="${jwt_refresh_secret}"
ENCRYPTION_KEY="${encryption_key}"
GOOGLE_CLIENT_ID="${google_client_id}"
GOOGLE_CLIENT_SECRET="${google_client_secret}"
KAKAO_CLIENT_ID="${kakao_client_id}"
KAKAO_CLIENT_SECRET="${kakao_client_secret}"
NAVER_CLIENT_ID="${naver_client_id}"
NAVER_CLIENT_SECRET="${naver_client_secret}"
MAIL_USERNAME="${mail_username}"
MAIL_PASSWORD="${mail_password}"
CORS_ALLOWED_ORIGINS="${cors_allowed_origins}"
S3_BUCKET_NAME="${s3_bucket_name}"
CLOUDFRONT_DOMAIN="${cloudfront_domain}"
ENVFILE_EOF
chmod 600 /etc/moa/backend/moa-backend.env
chown root:root /etc/moa/backend/moa-backend.env

# ExecStart만 래퍼로 교체; 변수는 EnvironmentFile에서 로드
cat > /etc/systemd/system/moa-backend.service.d/override.conf << 'OVERRIDE_EOF'
[Service]
EnvironmentFile=/etc/moa/backend/moa-backend.env
ExecStart=
ExecStart=/opt/moa/backend/start.sh
OVERRIDE_EOF

systemctl daemon-reload
systemctl restart moa-backend.service
