[Unit]
Description=MOA Backend Service
After=network.target

# TF apply → Launch Template user_data 가 아래 파일·drop-in 을 채웁니다.
#   - 전체 키/값: /etc/moa/backend/moa-backend.env
#   - ExecStart 래퍼: /etc/systemd/system/moa-backend.service.d/override.conf
# 합쳐진 유닛: systemctl cat moa-backend.service

[Service]
Type=simple
User=moa
Group=moa
WorkingDirectory=/opt/moa/backend
ExecStart=/usr/bin/java -Xms256m -Xmx256m -jar /opt/moa/backend/app.jar
Restart=always
RestartSec=5
Environment=SPRING_PROFILES_ACTIVE=prod,v2

[Install]
WantedBy=multi-user.target
