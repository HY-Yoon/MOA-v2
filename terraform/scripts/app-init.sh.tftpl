#!/bin/bash
set -euo pipefail

# 0. 타임존을 한국 시간(KST)으로 변경
timedatectl set-timezone Asia/Seoul

# 1. Systemd 서비스 환경변수 주입을 위한 override 디렉토리 생성
mkdir -p /etc/systemd/system/moa-backend.service.d

# 2. DB 정보를 systemd Environment 로 주입 (Spring Boot가 이를 읽어 실행됨)
cat > /etc/systemd/system/moa-backend.service.d/override.conf << 'OVERRIDE_EOF'
[Service]
Environment="SPRING_PROFILES_ACTIVE=prod,v2"
Environment="PORT=8080"
Environment="DB_HOST=${db_host}"
Environment="SPRING_DATASOURCE_URL=jdbc:postgresql://${db_host}:5432/${db_name}"
Environment="SPRING_DATASOURCE_USERNAME=${db_username}"
Environment="SPRING_DATASOURCE_PASSWORD=${db_password}"
Environment="REDIS_URL=rediss://default:${redis_password}@${redis_host}:${redis_port}"
Environment="REDIS_HOST=${redis_host}"
Environment="REDIS_PORT=${redis_port}"
Environment="REDIS_PASSWORD=${redis_password}"
Environment="KAFKA_BOOTSTRAP_SERVERS=${kafka_bootstrap_servers}"
Environment="KAFKA_SSL_TRUSTSTORE_CERT=${kafka_ssl_truststore_cert}"
Environment="KAFKA_SSL_KEYSTORE_CERT=${kafka_ssl_keystore_cert}"
Environment="KAFKA_SSL_KEYSTORE_KEY=${kafka_ssl_keystore_key}"
Environment="JWT_ACCESS_SECRET=${jwt_access_secret}"
Environment="JWT_REFRESH_SECRET=${jwt_refresh_secret}"
Environment="ENCRYPTION_KEY=${encryption_key}"
Environment="GOOGLE_CLIENT_ID=${google_client_id}"
Environment="GOOGLE_CLIENT_SECRET=${google_client_secret}"
Environment="KAKAO_CLIENT_ID=${kakao_client_id}"
Environment="KAKAO_CLIENT_SECRET=${kakao_client_secret}"
Environment="NAVER_CLIENT_ID=${naver_client_id}"
Environment="NAVER_CLIENT_SECRET=${naver_client_secret}"
Environment="MAIL_USERNAME=${mail_username}"
Environment="MAIL_PASSWORD=${mail_password}"
Environment="CORS_ALLOWED_ORIGINS=${cors_allowed_origins}"
Environment="S3_BUCKET_NAME=${s3_bucket_name}"
Environment="CLOUDFRONT_DOMAIN=${cloudfront_domain}"
OVERRIDE_EOF

# /etc/environment 에도 시스템 확인용 참고 기록
echo "SPRING_PROFILES_ACTIVE=prod,v2" >> /etc/environment
echo "DB_HOST=${db_host}" >> /etc/environment
echo "SPRING_DATASOURCE_URL=jdbc:postgresql://${db_host}:5432/${db_name}" >> /etc/environment

# 3. systemd 설정 다시 읽고, Spring Boot 앱 서비스 재시작
systemctl daemon-reload
systemctl restart moa-backend.service
